# 本地凭据 / 配置 — 复制本文件为 .env.local 并填入真实值
# .env.local 已加入 .gitignore，绝不会被提交

# ── BY 源（std.samr.gov.cn）─────────────────────────────
# 必填（启用 BY 源时），未配置则 BY 下载/检索链路直接报错
# BY_USERNAME=
# BY_PASSWORD=
# BY_DEPT_ID=

# ── LABR 源（labr.cc）──────────────────────────────────
# 必填，未配置则 labr 下载链路直接报错
# LABR_USERNAME=
# LABR_PASSWORD=

# ── iOS Capacitor / 跨域 API（默认关闭）──────────────────
# 仅当 iPhone App 需要访问此服务时填写；多个来源以英文逗号分隔。
# BZXZ_CORS_ORIGINS=capacitor://localhost
# 将来启用登录认证时，跨域 Cookie 必须同时启用以下两项，并通过 HTTPS 访问。
# BZXZ_COOKIE_CROSS_SITE=1
# BZXZ_COOKIE_SECURE=1
