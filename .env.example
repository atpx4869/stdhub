# 本地凭据 / 配置 — 复制本文件为 .env.local 并填入真实值
# .env.local 已加入 .gitignore，绝不会被提交

# ── BY 源（std.samr.gov.cn）─────────────────────────────
# 必填（启用 BY 源时），未配置则 BY 下载/检索链路直接报错
# BY_USERNAME=
# BY_PASSWORD=
# BY_DEPT_ID=
# 可选：BY 内网系统入口地址覆盖（VPS 部署经 frp/SSH 隧道映射到本地端口时使用，
# 如 http://127.0.0.1:18080；不配置则默认 http://172.16.100.72:8080）
# BY_BASE_URL=

# ── LABR 源（labr.cc）──────────────────────────────────
# 必填，未配置则 labr 下载链路直接报错
# LABR_USERNAME=
# LABR_PASSWORD=

# ── OCR worker startup ─────────────────────────────────────────────────────
# ddddocr cold start is slower on some NAS devices. The default is 20000ms;
# set to 30000 or higher only when startup logs show a timeout.
# BZXZ_OCR_STARTUP_TIMEOUT_MS=30000

# ── 外网反向代理保护（建议）────────────────────────────────────────────────
# 产品模式是单用户免登录管理员。本机 loopback 可直接使用；
# 非本机监听必须配置 STDHUB_PROXY_TOKEN，由 Lucky/Nginx 注入同一 Header。
# STDHUB_PROXY_TOKEN=
# 仅在确认要局域网直连、且无法走反代时才打开。打开后同网段可直接访问全部管理员功能。
# STDHUB_ALLOW_OPEN_ADMIN=1
# 默认信任紧邻的一层反代。多层代理或指定可信网段时可按 Express trust proxy 语法覆盖，
# 例如 2、loopback, linklocal, uniquelocal。不要在端口可被直接访问时设置为 true。
# STDHUB_TRUST_PROXY=1
